{
  "name": "telegram-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "login": "node --env-file-if-exists=.env scripts/login.mjs",
    "poll": "node --env-file-if-exists=.env src/collect.mjs",
    "login:qr": "node --env-file-if-exists=.env scripts/login-qr.mjs",
    "targets": "node --env-file-if-exists=.env scripts/targets.mjs",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "sync": "git pull --rebase"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "teleproto": "^1.229.0"
  }
}
