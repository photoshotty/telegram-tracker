# From https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Random secret that turns Telegram ids into anonymous folder names in the public repo and
# encrypts the name map. Generate with `npm run targets -- keygen`. Same value as the GitHub
# secret TG_DATA_KEY. Never change it.
TG_DATA_KEY=
# Only for running the collector on this machine (`npm run poll`, writes to data-local/).
# The dashboard does NOT need it: GitHub Actions has its own session in the TG_SESSION secret.
TG_SESSION=
# Optional for local test polls: JSON array of usernames to poll (CI uses the TG_TARGETS secret).
# TG_TARGETS=["alice","bob"]
