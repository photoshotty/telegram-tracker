# From https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Your LOCAL session (npm run login:qr). CI uses a separate session stored only in GitHub secrets.
TG_SESSION=
# Random secret that turns Telegram ids into anonymous folder names in the public repo.
# Generate with `npm run targets -- keygen`. Same value locally and in the GitHub secret. Never change it.
TG_DATA_KEY=
# Optional for local test polls: JSON array of usernames to poll.
# CI gets this from the TG_TARGETS secret (npm run targets -- sync).
# TG_TARGETS=["alice","bob"]
